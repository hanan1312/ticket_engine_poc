# Copy to /etc/ticket-engine/ticket-engine.env (owner root, mode 600) and edit.
# Read by deploy/ticket-engine.service.

# Signs the login session cookie. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left empty the app generates one and keeps it in database/.secret_key.
SECRET_KEY=

# Port gunicorn listens on (loopback only; nginx forwards to it).
PORT=4044

# The app is behind nginx: trust its X-Forwarded-* headers so password-reset links use the
# public address.
BEHIND_PROXY=1

# Set to 1 once HTTPS is working (certbot), so the session cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=0

# Never 1 on a server: enables the interactive debugger (remote code execution).
FLASK_DEBUG=0

# WhatsApp notifications service (deploy/ticket-engine-whatsapp.service), local only.
NOTIFICATIONS_URL=http://127.0.0.1:5050
NOTIFICATIONS_CENTER_ID=lab

# Tabs, sub-tabs and names (see README.md). Defaults to the repo's config/ui.json, which each
# deploy overwrites -- point this at a copy outside /opt to edit it on the server instead.
#UI_CONFIG=/etc/ticket-engine/ui.json
