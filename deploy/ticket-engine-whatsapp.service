# Optional: systemd unit for the WhatsApp notifications service (notifications/server.js).
# Only needed if WhatsApp notifications are switched on in Preferences.
# Port 5050 must NOT be opened in the firewall -- only the Flask app on this machine uses it.
[Unit]
Description=Ticket Engine WhatsApp notifications service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ticketengine
Group=ticketengine
WorkingDirectory=/opt/ticket-engine/notifications
Environment=NODE_PORT=5050
# Chrome writes its profile/cache under $HOME; keep that inside the writable folder below.
Environment=HOME=/opt/ticket-engine/notifications
# Optional: force a specific browser (otherwise google-chrome, chromium, then puppeteer's own).
#Environment=PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# whatsapp-web.js keeps the paired session here
ReadWritePaths=/opt/ticket-engine/notifications

[Install]
WantedBy=multi-user.target
